HideFromSearchIndex: true
ShowInNavigation: false
EditLink:
---
<form onsubmit="return false">
    <div class="form-group">
        <label for="search">Search Query</label>
        <input class="form-control" type="search" aria-label="Search" id="search" autocomplete="off">
    </div>
</form>

<p id="search-status" class="text-muted small" role="status"></p>
<div id="search-results"></div>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/minisearch@7.2.0/dist/umd/index.min.js"></script>
    <script src="@Context.GetLink("/assets/js/search.js")"></script>
    <script>
        const maxResults = 50;
        const searchInput = document.getElementById("search");
        const searchStatus = document.getElementById("search-status");
        const searchResults = document.getElementById("search-results");
        let searchIndex = null;
        let searchTimeout = null;

        function runSearch() {
            const query = searchInput.value.trim();

            // Update the URL so that the user can come back to these results
            const url = new URL(window.location.href);
            if (query) {
                url.searchParams.set("query", query);
            } else {
                url.searchParams.delete("query");
            }
            window.history.replaceState(null, "", url.href);

            searchResults.innerHTML = "";
            if (!searchIndex) {
                return;
            }

            // If the search term is less than 2 characters, wait until the user types some more stuff
            if (query.length < 2) {
                searchStatus.textContent = "";
                return;
            }

            const { results, partial } = searchIndex.search(query);
            if (results.length === 0) {
                searchStatus.textContent = "No results found";
                return;
            }

            searchStatus.textContent =
                (partial ? "No page contains all search terms, showing pages containing some of them. " : "")
                + `${results.length} result${results.length === 1 ? "" : "s"}`
                + (results.length > maxResults ? `, showing the first ${maxResults}` : "");

            searchResults.innerHTML = results.slice(0, maxResults).map(result => `
<div class="p-3 mb-2 bg-light page-box">
    <h4><a href="${result.link.replace(/"/g, "%22")}">${result.titleHtml}</a></h4>
    ${result.sectionHtml ? `<div class="small text-muted mb-1">${result.sectionHtml}</div>` : ""}
    ${result.api ? `<div class="small text-muted">API reference</div>` : `<div class="font-size-sm">${result.snippetHtml}</div>`}
</div>
`).join("");
        }

        searchInput.addEventListener("input", () => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(runSearch, 100);
        });

        // If the URL contains a search parameter, show it until the search data is loaded
        const queryParam = new URLSearchParams(window.location.search).get("query");
        if (queryParam) {
            searchInput.value = queryParam;
        }
        searchInput.focus();

        searchStatus.textContent = "Loading search index…";
        DocsSearch.load("@Context.GetLink("/search-data.json.gz")")
            .then(index => {
                searchIndex = index;
                searchStatus.textContent = "";
                runSearch();
            })
            .catch(error => {
                console.error(error);
                searchStatus.textContent = "The search index could not be loaded.";
            });
    </script>
}
